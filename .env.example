# Copy this file to .env and fill in the values for your environment.
# Every variable below maps to a field in app/core/config.py (Settings).

# Deployment environment (development, staging, production).
ENV=development

# Asynchronous PostgreSQL connection string.
# The 'postgresql+asyncpg' prefix is required for non-blocking I/O.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>

# Google API Key for Gemini (https://aistudio.google.com/apikey).
GOOGLE_API_KEY=
